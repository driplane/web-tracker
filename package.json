{
  "name": "@driplane/web",
  "version": "0.0.0-dev",
  "description": "Driplane web tracker",
  "main": "./dist/driplane.js",
  "module": "./dist/driplane.js",
  "typings": "dist/driplane.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "build": "esbuild src/driplane.ts src/modules/**.ts --bundle --splitting --minify --format=esm --outdir=dist",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "serve": "esbuild src/driplane.ts src/modules/**.ts --bundle --splitting --format=esm --outdir=demo/dist --watch --servedir=demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driplane/web-tracker.git"
  },
  "author": "Driplane",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/driplane/web-tracker/issues"
  },
  "homepage": "https://github.com/driplane/web-tracker#readme",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3",
    "esbuild": "^0.24.0",
    "semantic-release": "^23.0.2"
  },
  "dependencies": {
    "ua-parser-js": "^1.0.37",
    "uuid": "^11.0.2",
    "web-vitals": "^4.2.4"
  }
}
